# Every setting is optional. The app starts and works without this file.
# Copy to .env and fill in what you have.

PORT=3000
# URL written into QR codes. Set it to your HTTPS domain for phone or live use.
PUBLIC_BASE_URL=http://localhost:3000
# Demo school, one-click role switching and "simulate scan". Set to false for a real school.
DEMO_MODE=true

# Sign-in with Google and SMS OTP (dashboard.clerk.com, API keys).
# Without both keys the app uses a demo phone login with the code shown on screen.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# NVIDIA Build (build.nvidia.com, API keys). Speech-to-text, clean-up, translation, speech.
NVIDIA_API_KEY=
NVIDIA_LLM_BASE=https://integrate.api.nvidia.com/v1
# Model ids as listed on build.nvidia.com, without OpenRouter's ":free" ending. Both must be chat models.
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_LLM_FALLBACK=minimaxai/minimax-m3.1-flash
NVIDIA_GRPC_HOST=grpc.nvcf.nvidia.com:443
NVIDIA_ASR_PARAKEET_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca
NVIDIA_ASR_WHISPER_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
NVIDIA_TTS_MAGPIE_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com
NVIDIA_TRANSLATE_MODEL=nvidia/riva-translate-4b-instruct-v2
# Set to true to use Riva Translate for Hindi and English pairs.
NVIDIA_TRANSLATE_HI_EN=false
NVIDIA_RPM_LIMIT=35

# OpenRouter (openrouter.ai/keys). Free models, used when NVIDIA fails or is rate limited.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Only needed behind a reverse proxy such as Caddy, so rate limits see real client addresses.
TRUST_PROXY=false
